# The HMAC key for credentials AND the audit chain. Must be stable: rotating it
# invalidates live credentials and makes previously-written audit rows fail
# verification. See RUNBOOK.md section 7 before changing it in a live share.
PORTAL_SIGNING_KEY=dev-signing-key-not-a-real-secret

# Admin connection (schema management and provider-side data loading only).
# Defaults match scripts/pg_local.sh.
PGHOST=127.0.0.1
PGPORT=5435
PGDATABASE=sharing
PGUSER=shareadmin

# The application connects as portal_app, which holds NO privileges on any base
# table. Never point this at a privileged role: the whole enforcement argument
# rests on the app being unable to read the tables directly.
# APP_URL=postgresql://portal_app@127.0.0.1:5435/sharing
